# Скопируйте в .env рядом с docker-compose.yml и заполните. Файл .env в git не добавляйте.

# Домен для сертификата Caddy; DNS-запись A должна указывать на этот сервер.
# Для локальной проверки оставьте localhost.
MCPSQL_DOMAIN=mcp.example.com

# Версия образов (теги malexple/mcp-sql, malexple/mcp-sql-bot, malexple/mcp-sql-web).
MCPSQL_TAG=0.1.0

MCPSQL_DATA_DIR=/data

# Многопользовательский режим: ключи выдаёт бот, статические ключи не нужны.
MCPSQL_MULTI_ENABLED=true

# Секрет между ботом и сервисом. Длинная случайная строка:
#   openssl rand -hex 32
MCPSQL_INTERNAL_KEY=<случайная строка>

# Токен бота @mcp_sql_bot от BotFather. Если он попал в чужие руки, отзовите его командой /revoke.
BOT_TOKEN=<токен>

# Адрес, который бот показывает пользователям (без слеша в конце).
BOT_PUBLIC_URL=https://mcp.example.com

# --- Необязательно: лимиты, ниже значения по умолчанию ---
#MCPSQL_MAX_ACTIVE_USERS=50
#MCPSQL_KEY_ISSUES_PER_DAY=5
#MCPSQL_MAX_WORKSPACES=3
#MCPSQL_MAX_DB_MB=20
#MCPSQL_UPLOADS_PER_DAY=10
#MCPSQL_WRITE_MB_PER_DAY=300
#MCPSQL_PATCH_INTERVAL_SECONDS=30
#MCPSQL_REQUESTS_PER_DAY=5000
#MCPSQL_MIN_FREE_DISK_MB=2048

# --- Только для режима одного пользователя (MCPSQL_MULTI_ENABLED=false) ---
#MCPSQL_READ_KEY=read-secret
#MCPSQL_WRITE_KEY=write-secret
